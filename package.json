{
  "name": "personal-life-os",
  "version": "1.0.0",
  "description": "Complete personal life operating system with journal, trackers, and dashboard",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/server.js",
    "client:dev": "cd client && npm run dev",
    "server:start": "node server/server.js",
    "client:build": "cd client && npm run build",
    "seed": "node database/seed.js",
    "test": "node --test server/__tests__/*.test.js",
    "lint": "npm run test"
  },
  "keywords": [
    "journal",
    "tracker",
    "life-os",
    "productivity"
  ],
  "author": "Part-time Coder",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^7.5.0",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.22"
  }
}
